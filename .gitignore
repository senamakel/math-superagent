# Build output
/target/
**/*.rs.bk
*.pdb

# Coverage output
/coverage/
/coverage.json
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Host directory mounted as the jailed agent runtime's /workspace.
#
# Workspace contents are committed on purpose: the derivation, the program, and
# the per-run notes are the record of how an answer was reached, which is the
# point of the product. Only machine-regenerable and bulky artifacts are
# excluded below.
#
# Pip installs land here because the container root filesystem is read-only.
# They are vendored dependencies, not work product, and are reinstallable.
/workspace/**/.python-packages/
__pycache__/
*.py[cod]

# The agent's own per-workspace git history, kept out of the product
# repository's history. A nested `.git` would make this an embedded repo.
/workspace/**/.workspace-history/

# Untouched bytes of every download, kept only for debugging a conversion.
# Regenerable by re-downloading, and often large or binary.
/workspace/**/raw/

# Runtime event logs. Several megabytes per run, and the derivation and notes
# already carry the reasoning worth keeping. Read them locally or in Langfuse.
# `config/` holds the run's plumbing; `config.toml` and `problem.url` in it are
# small and worth keeping, so the two bulky entries are named rather than the
# folder.
/workspace/**/config/trace.jsonl
/workspace/**/config/.document-index.json
# What `euler-tui` teed from the console. It is the same events `trace.jsonl`
# already carries, formatted for a reader rather than a parser.
/workspace/**/config/console.log

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.log