# Build output
/target/
**/*.rs.bk
*.pdb

# Coverage output
/coverage/
/coverage.json
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Host directory mounted as the jailed agent runtime's /workspace.
#
# Workspace contents are committed on purpose: the derivation, the program, the
# per-run notes, and `trace.jsonl` are the record of how an answer was reached,
# which is the point of the product. Only machine-regenerable artifacts are
# excluded below.
#
# Pip installs land here because the container root filesystem is read-only.
# They are vendored dependencies, not work product, and are reinstallable.
/workspace/**/.python-packages/
__pycache__/
*.py[cod]

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
