# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Document every environment variable the crate, its tests, or its examples
# read — including optional ones — with a placeholder value and a comment
# saying what it is for. `.env.example` is the contract; `.env` is the secret.

# Log filter for the `tracing`/`env_logger` style ecosystem.
# RUST_LOG=info

# Backtraces for local debugging: 1 for a short backtrace, "full" for all frames.
# RUST_BACKTRACE=1

# OpenRouter model provider used by `agent::ObservedAgent::from_env`.
OPENROUTER_API_KEY=replace-me
# Optional OpenRouter model override. The built-in default is
# `deepseek/deepseek-v4-flash-0731`, served through the preferred provider below.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Exa web search used by the hello-world agent's `exa_search` tool.
EXA_API_KEY=replace-me

# Compose provides this hostname for the local Cognee API. Override it only
# when running against another self-hosted Cognee instance.
COGNEE_API_URL=http://cognee:8000
# The wrappers set MATH_AGENT_WORKSPACE_LABEL. Cognee uses it to isolate
# automatic session-memory datasets by project and runtime run.

# Direct Langfuse ingestion used for TinyAgents loop observations. The
# orchestrator and every specialist run export to it, with model and tool
# payloads captured, so a trace shows the whole delegation tree.
LANGFUSE_BASE_URL=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me

# Run budget. Each is optional; an unset, empty, unparsable, or zero value keeps
# the built-in default. Prefer the `./agent` and `./euler` flags where they
# exist. See `src/agent/budget.rs`.
# Model calls allowed per agent run before it stops with partial results (250).
# MATH_AGENT_MAX_MODEL_CALLS=250
# Tool calls allowed per agent run (4000). Kept out of reach of the model-call
# cap on purpose; only that cap stops gracefully.
# MATH_AGENT_MAX_TOOL_CALLS=4000
# Wall-clock ceiling for one agent run, in minutes (120).
# MATH_AGENT_RUN_MINUTES=120
# Safety ceiling on output tokens per model turn (12000). Must stay above a
# normal turn: a cap that trips truncates the model and forces a retry.
# MATH_AGENT_TURN_OUTPUT_TOKENS=12000
# Wall-clock ceiling for one tool call, in minutes (10).
# MATH_AGENT_TOOL_MINUTES=10

# Preferred OpenRouter provider slug. Defaults to `deepinfra`; one consistent
# provider maximises prompt-cache hits. Fallbacks stay enabled either way, and
# each agent then sticks to whichever provider actually served it.
# MATH_AGENT_PROVIDER=deepinfra

# Spawned agent runs allowed to execute at once (50). The rest queue; spawning
# stays non-blocking. Keep it well above the real fan-out — a run holds its
# slot while awaiting children it spawned itself.
# MATH_AGENT_MAX_CONCURRENT_AGENTS=50

# Set to `off` to withhold `exa_search` from the research agent, making a run a
# test of reasoning rather than of lookup. Equivalent to `--no-research`.
# MATH_AGENT_RESEARCH=on
