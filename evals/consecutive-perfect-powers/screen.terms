# Blocklist — consecutive-perfect-powers
#
# PLAINTEXT. Host-side only. Never mounted into the container; see
# evals/README.md and the header of
# evals/unit-distance-plane-chromatic/screen.terms for the format and for why
# the compiled form is hashed.
#
# De-naming is weak here — `x^p - y^q = 1` is self-identifying — so this list
# does more work than the other two, and the leakage audit does more still.

salt = b48d0c73f5921ae6d70c3b18594fe2a7

[block]

