#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: ./steer <problem> <directive...>" >&2
    echo "       ./steer --workspace relative/path <directive...>" >&2
    echo "" >&2
    echo "Directs a run that is already going. The run picks the directive up" >&2
    echo "on its own schedule and never waits for it; what it did about it is" >&2
    echo "written to the workspace's config/DIRECTIVES.md." >&2
}

workspace_subdir=${MATH_AGENT_WORKSPACE:-}
if [ "$#" -eq 0 ]; then
    usage
    exit 2
fi

case "${1-}" in
    -h|--help|help)
        usage
        exit 0
        ;;
    --workspace)
        if [ "$#" -lt 2 ]; then
            usage
            exit 2
        fi
        workspace_subdir=$2
        shift 2
        ;;
    *)
        # A bare problem number is the common case, and it names the same
        # workspace `./euler` and `./euler-tui` do. Anything else has to be
        # spelled out with --workspace, so a mistyped slug cannot silently
        # become a new directory nobody is running.
        case "$1" in
            ''|*[!0-9]*)
                echo "problem must be a positive integer, or use --workspace" >&2
                exit 2
                ;;
        esac
        if [ "$1" -eq 0 ]; then
            echo "problem must be a positive integer" >&2
            exit 2
        fi
        workspace_subdir=project-euler/$1
        shift
        ;;
esac

if [ -z "$workspace_subdir" ]; then
    usage
    exit 2
fi
if [ "$#" -eq 0 ]; then
    echo "nothing to say; give the directive after the workspace" >&2
    exit 2
fi

# The same containment checks `scripts/run-agent` makes, and for the same
# reason: this writes into a directory named on the command line, and a prompt
# instruction is not a security control.
case "/$workspace_subdir/" in
    /*/../*|/*/./*|//*|/*\\*|/./)
        echo "workspace must be a relative subdirectory without traversal" >&2
        exit 2
        ;;
esac

workspace_root=$repository_root/workspace
workspace_path=$workspace_root/$workspace_subdir
if [ ! -d "$workspace_path" ]; then
    echo "no workspace at workspace/$workspace_subdir; nothing is running there" >&2
    exit 2
fi
workspace_root=$(CDPATH= cd -- "$workspace_root" && pwd -P)
workspace_path=$(CDPATH= cd -- "$workspace_path" && pwd -P)
case "$workspace_path" in
    "$workspace_root"|"$workspace_root"/*) ;;
    *)
        echo "workspace resolves outside $workspace_root" >&2
        exit 2
        ;;
esac

# Every remaining argument is the directive, joined with spaces, so it can be
# written without quoting.
directive=$*

exec cargo run --quiet --example steer -- "$workspace_path" "$directive"
