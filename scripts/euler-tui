#!/usr/bin/env python3
"""A tabbed console for one Project Euler run, one tab per team.

The runtime prints a single interleaved stream: eleven roles, several
concurrent child runs each, one line per model call, tool call, and tool
result. It is the right format for a trace and the wrong one for watching —
the organizer alone produced 232 of one run's first 400 lines, so the solve's
own progress scrolls past between two index refreshes.

This splits that stream by role without changing it. Every byte still lands in
a log file exactly as the runtime emitted it, so `grep` over the file and the
existing `trace.jsonl` tooling keep working; the tabs are a view, not a
filter, and no line is dropped from the record because a tab was not open.

Without a terminal it degrades to a plain tee. That is deliberate: the same
command has to work when a person is watching and when something is scraping
the output.
"""

from __future__ import annotations

import argparse
import curses
import os
import re
import signal
import subprocess
import sys
import threading
import time
from collections import OrderedDict, deque
from pathlib import Path

# `[MM:SS] role/agent-run-N  rest` or `[MM:SS] orchestrator  rest`. The
# timestamp is elapsed run time, not wall clock, which is why it is kept
# verbatim rather than reformatted: it is what the console and the trace agree
# on when something has to be found in both.
LINE = re.compile(r"^\[(?P<elapsed>[\d:]+)\]\s+(?P<who>\S+)\s+(?P<rest>.*)$")

# Lines worth counting in the status bar. Each names a failure the runtime is
# built to survive, so the count answers "is this run healthy" without reading
# any tab.
COUNTED = OrderedDict(
    (
        ("err", "error: tool error"),
        ("trunc", "TRUNCATED"),
        ("retry", "model RETRY"),
        ("reroute", "PROVIDER FAILED"),
        ("timeout", "timed out after"),
        ("filed", "filed from the workspace root"),
    )
)

# Lines every tab shows, whichever role emitted them. The loop's verdicts are
# the run's spine: a score, a verdict, and an attempt boundary are the three
# things a watcher never wants to have switched tabs to miss.
PINNED = ("solution loop:", "team ")

# Per-tab scrollback. Ten thousand lines is roughly an hour of one busy role
# and costs a few megabytes; the log file holds everything regardless.
SCROLLBACK = 10_000


class Runs:
    """The stream, split by role, plus the counters and the last cost."""

    def __init__(self) -> None:
        self.tabs: OrderedDict[str, deque[str]] = OrderedDict()
        self.tabs["all"] = deque(maxlen=SCROLLBACK)
        self.counts = OrderedDict((name, 0) for name in COUNTED)
        self.elapsed = ""
        self.cost = ""
        self.lock = threading.Lock()
        self.ended = False
        self.started = time.monotonic()

    def waiting(self) -> str:
        """How long since launch, for the window before the run's own clock.

        `./euler` builds the image, fetches the statement, and builds again
        with `--quiet`, emitting nothing throughout — tens of seconds warm and
        minutes cold. Showing a frozen `00:00` across all of it is why the
        first version of this looked like it had failed to start.
        """
        seconds = int(time.monotonic() - self.started)
        return f"{seconds // 60:02d}:{seconds % 60:02d}"

    def add(self, line: str) -> None:
        """Files one raw line, creating a tab the first time a role speaks."""
        line = line.rstrip("\n")
        match = LINE.match(line)
        with self.lock:
            self.tabs["all"].append(line)
            for name, needle in COUNTED.items():
                if needle in line:
                    self.counts[name] += 1
            cost = line.rsplit("$", 1)
            if len(cost) == 2 and cost[1].replace(".", "", 1).isdigit():
                self.cost = "$" + cost[1]
            if not match:
                # Anything unparsed — a build line, a panic, a bare traceback —
                # belongs somewhere a reader will actually look.
                return
            self.elapsed = match["elapsed"]
            role = match["who"].split("/", 1)[0]
            if role not in self.tabs:
                self.tabs[role] = deque(maxlen=SCROLLBACK)
            self.tabs[role].append(line)
            if any(pin in line for pin in PINNED):
                for name, rows in self.tabs.items():
                    if name not in ("all", role):
                        rows.append(line)

    def snapshot(self) -> tuple[list[str], dict[str, deque[str]], dict[str, int], str, str]:
        with self.lock:
            return (
                list(self.tabs),
                dict(self.tabs),
                dict(self.counts),
                self.elapsed,
                self.cost,
            )


def pump(stream, runs: Runs, log, echo: bool) -> None:
    """Reads the child's output into the model, the log, and maybe stdout."""
    try:
        for raw in iter(stream.readline, ""):
            runs.add(raw)
            log.write(raw)
            log.flush()
            if echo:
                sys.stdout.write(raw)
                sys.stdout.flush()
    except ValueError:
        # Detaching closes the pipe under this thread. That is the normal way
        # the view ends, so it must not print a traceback over the terminal
        # the user is about to get back.
        pass
    runs.ended = True


def paint(line: str) -> int:
    """Chooses the colour for one line, by what the line reports.

    Colour is doing one job here: making the shape of a run readable at a
    glance, so an eye scanning a fast-scrolling tab lands on the events that
    change what happens next. Faults are red because they are the reason to
    look; the loop's own verdicts are yellow and bold because they are the run
    changing state; a finished tool call is green and a started one cyan, so
    the gap between them — where a ten-minute command sits — is visible as a
    colour that has not yet been answered. Model calls are dimmed, because
    they are the bulk of the stream and almost never the thing being looked
    for.
    """
    if any(pin in line for pin in PINNED):
        return colour(LOOP) | curses.A_BOLD
    if "error" in line:
        return colour(FAULT)
    if any(word in line for word in ("TRUNCATED", "model RETRY", "PROVIDER FAILED")):
        return colour(WARN)
    if "filed from the workspace root" in line or "left at the workspace root" in line:
        return colour(WARN)
    if "spawned:" in line or "run started" in line:
        return colour(SPAWN)
    if "tool  done" in line:
        return colour(DONE)
    if "tool  call" in line:
        return colour(CALL)
    if "model" in line:
        return curses.A_DIM
    return curses.A_NORMAL


def draw(screen, runs: Runs, tab: int, offset: int) -> int:
    """Paints one frame and returns the tab index actually shown."""
    names, tabs, counts, elapsed, cost = runs.snapshot()
    tab = max(0, min(tab, len(names) - 1))
    height, width = screen.getmaxyx()
    screen.erase()

    # The tab bar is drawn piece by piece rather than as one string, so the
    # open tab can be reversed and the rest dimmed. A bar where every entry
    # looks alike is a bar you have to read instead of glance at.
    column = 0
    for index, name in enumerate(names):
        label = f" {index + 1}:{name} "
        if column + len(label) >= width - 1:
            break
        attribute = (
            colour(TAB) | curses.A_REVERSE | curses.A_BOLD
            if index == tab
            else colour(TAB) | curses.A_DIM
        )
        screen.addnstr(0, column, label, width - 1 - column, attribute)
        column += len(label)

    rows = list(tabs[names[tab]])
    body = height - 2
    # `offset` counts lines back from the live end, so zero follows the tail.
    end = len(rows) - offset
    view = rows[max(0, end - body) : max(0, end)]
    for index, line in enumerate(view):
        screen.addnstr(1 + index, 0, line, width - 1, paint(line))

    faults = " ".join(f"{name}={value}" for name, value in counts.items() if value)
    if runs.ended:
        state = "ended"
    elif elapsed:
        state = "running"
    else:
        # The container has not spoken yet. Say so, and count in wall clock,
        # or a silent build reads as a hung program.
        state = "starting"
    live = "LIVE" if offset == 0 else f"-{offset}"
    clock = elapsed or runs.waiting()
    status = f" {clock} {state} {live} {cost} {faults}  [tab/n/p tab, arrows scroll, q quit] "
    # A status bar carrying a fault count is worth colouring: red says the run
    # has met something, and the count says how often, without opening a tab.
    bar = colour(FAULT) if faults else colour(TAB)
    screen.addnstr(height - 1, 0, status.ljust(width - 1), width - 1, bar | curses.A_REVERSE)
    screen.refresh()
    return tab


def watch(screen, runs: Runs) -> None:
    """The curses loop. Quitting detaches; it never stops the run."""
    curses.curs_set(0)
    screen.nodelay(True)
    screen.timeout(200)
    tab, offset = 0, 0
    while True:
        tab = draw(screen, runs, tab, offset)
        try:
            key = screen.getch()
        except curses.error:
            key = -1
        if key in (ord("q"), 27):
            return
        if key in (ord("n"), curses.KEY_RIGHT, ord("\t")):
            tab, offset = tab + 1, 0
        elif key in (ord("p"), curses.KEY_LEFT):
            tab, offset = tab - 1, 0
        elif key == curses.KEY_UP:
            offset += 1
        elif key == curses.KEY_DOWN:
            offset = max(0, offset - 1)
        elif key == curses.KEY_NPAGE:
            offset = max(0, offset - (screen.getmaxyx()[0] - 2))
        elif key == curses.KEY_PPAGE:
            offset += screen.getmaxyx()[0] - 2
        elif key == ord("g"):
            offset = 0
        elif ord("1") <= key <= ord("9"):
            tab, offset = key - ord("1"), 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="euler-tui",
        description="Run or continue one Project Euler box with a tab per team.",
    )
    parser.add_argument("problem", type=int, help="Project Euler problem number")
    parser.add_argument(
        "--no-research",
        action="store_true",
        help="withhold web search, so the run tests reasoning rather than lookup",
    )
    parser.add_argument(
        "--log",
        type=Path,
        help="where to tee the raw stream (default: the workspace's config/console.log)",
    )
    parser.add_argument(
        "--plain",
        action="store_true",
        help="skip the tabs and stream to stdout, as when scripting",
    )
    parser.add_argument(
        "--replay",
        action="store_true",
        help="open the tabs on the existing log without starting or continuing a run",
    )
    parser.add_argument("extra", nargs="*", help="extra instructions for the run")
    arguments = parser.parse_args()

    if arguments.problem <= 0:
        parser.error("problem number must be a positive integer")

    root = Path(__file__).resolve().parent.parent
    workspace = root / "workspace" / "project-euler" / str(arguments.problem)
    log_path = arguments.log or workspace / "config" / "console.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)

    command = [str(root / "euler")]
    if arguments.no_research:
        command.append("--no-research")
    command.append(str(arguments.problem))
    command.extend(arguments.extra)

    # A workspace that already holds work is continued rather than restarted:
    # `euler` seeds only what is missing, and the loop reads what is on disk.
    existing = workspace.exists() and any(workspace.glob("code/*.py"))
    print(
        f"{'continuing' if existing else 'starting'} problem {arguments.problem}"
        f" — log at {log_path}",
        file=sys.stderr,
    )

    runs = Runs()
    tabs = not arguments.plain and sys.stdout.isatty()

    if arguments.replay:
        # Reading a log costs nothing and starts nothing, which makes it both
        # the way to look at a finished run and the only way to exercise the
        # tabs without spending a container.
        if not log_path.exists():
            print(f"no log at {log_path}", file=sys.stderr)
            return 1
        with open(log_path, encoding="utf-8", errors="replace") as log:
            for raw in log:
                runs.add(raw)
                if not tabs:
                    sys.stdout.write(raw)
        runs.ended = True
        if tabs:
            curses.wrapper(watch, runs)
        return 0
    # Seed the view so its first frame says what is happening. An empty body
    # under a one-entry tab bar is indistinguishable from a program that never
    # started, which is exactly how the first version of this was read: the
    # build and the statement fetch are silent, so nothing appeared for half a
    # minute warm and would appear for minutes cold.
    runs.add(
        f"{'continuing' if existing else 'starting'} problem {arguments.problem}:"
        " building the image, fetching the statement, starting the container."
        " This part is silent and slow on a cold build; the first [00:00] line"
        " below is the run itself."
    )

    with open(log_path, "a", encoding="utf-8") as log, subprocess.Popen(
        command,
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        # Its own process group, so the terminal's Ctrl-C reaches this script
        # and not the container: quitting the view must never kill the run.
        start_new_session=True,
    ) as child:
        reader = threading.Thread(
            target=pump, args=(child.stdout, runs, log, not tabs), daemon=True
        )
        reader.start()
        try:
            if tabs:
                curses.wrapper(watch, runs)
            else:
                reader.join()
        except KeyboardInterrupt:
            pass
        if child.poll() is None:
            # Detaching is the default; the run continues in Docker and this
            # script can be started again against the same log. A `return`
            # inside `finally` would swallow whatever brought us here, so the
            # decision is made in the normal path.
            print(
                f"detached — the run continues; follow it with `tail -f {log_path}`",
                file=sys.stderr,
            )
            os.killpg(child.pid, signal.SIGCONT)
            return 0
        return child.wait()


if __name__ == "__main__":
    sys.exit(main())
