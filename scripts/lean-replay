#!/bin/sh
# Re-check every .lean file a run has left behind, and score what was found.
#
# Four runs have produced Lean, and until now nothing had ever read the result
# back. Two questions went unanswered because of it. The first is the plain one:
# how much of what the model wrote actually holds up — a number this repository
# had opinions about and no measurement of. The second is sharper. Verdicts sit
# on disk in `code/out/lean/` from the moment an attempt filed them, and a
# formalisation whose file was later edited, or whose toolchain has since moved,
# keeps a verdict it may have outgrown. Replaying is how that is noticed.
#
# So the report has two halves, and the second is the one to read first. Every
# file is re-checked; where a filed verdict already exists, the two are compared
# and a DISAGREEMENT is called out by name. A disagreement means one of the two
# is wrong, and finding out which is worth more than either number on its own.
#
# Nothing is written into any workspace. `scripts/lean-check` is called without
# `--file-verdict`, so the existing evidence is read and never overwritten — a
# replay that silently refreshed the verdicts it was auditing would destroy the
# only thing it was there to find.
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: scripts/lean-replay [--all | <workspace-subfolder>...] [--out <dir>]" >&2
    echo "" >&2
    echo "  --all    every workspace under workspace/ that contains a .lean file" >&2
    echo "  --out    where the reports are written (default evals/lean-baseline)" >&2
}

out_dir=evals/lean-baseline
all=no
targets=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --all) all=yes; shift ;;
        --out)
            if [ "$#" -lt 2 ]; then usage; exit 2; fi
            out_dir=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "unknown flag: $1" >&2; usage; exit 2 ;;
        *) targets="$targets $1"; shift ;;
    esac
done

if [ "$all" = no ] && [ -z "$targets" ]; then
    usage
    exit 2
fi

if [ "$all" = yes ]; then
    # A workspace is a directory holding at least one .lean file, found rather
    # than listed: the set grows every time a run formalises something, and a
    # hardcoded list would quietly stop covering the newest work — which is the
    # work most worth checking.
    targets=$(find workspace -name '*.lean' -not -path '*/.*' \
        | sed 's|^workspace/||' \
        | while IFS= read -r path; do
              # The workspace root is the first two segments: `conjectures/x`
              # or `project-euler/622`.
              echo "$path" | cut -d/ -f1,2
          done \
        | sort -u)
fi

mkdir -p "$out_dir"
summary=$out_dir/SUMMARY.md
: > "$summary"

printf '# Lean baseline — every formalisation a run has left behind, re-checked\n\n' >> "$summary"
printf 'Generated by `scripts/lean-replay`. Each file is re-run through the kernel in\n' >> "$summary"
printf 'the current runtime image. Where a verdict was already filed in\n' >> "$summary"
printf '`code/out/lean/`, the two are compared: a **disagreement** means the file, the\n' >> "$summary"
printf 'toolchain, or the filed verdict has moved since the attempt that produced it.\n\n' >> "$summary"
printf '| Workspace | Files | Verified | Conditional | Failed | Disagreements |\n' >> "$summary"
printf '| --- | ---: | ---: | ---: | ---: | ---: |\n' >> "$summary"

total_files=0
total_verified=0
total_conditional=0
total_failed=0
total_disagree=0

for workspace_subdir in $targets; do
    workspace_path=workspace/$workspace_subdir
    [ -d "$workspace_path" ] || continue
    slug=$(echo "$workspace_subdir" | tr '/' '-')
    report=$out_dir/$slug.md

    files=0
    verified=0
    conditional=0
    failed=0
    disagree=0

    printf '# %s — Lean replay\n\n' "$workspace_subdir" > "$report"
    printf '| File | Outcome | Filed | Agrees |\n| --- | --- | --- | --- |\n' >> "$report"

    for source in $(cd "$workspace_path" && find . -name '*.lean' -not -path './.*' \
                    | sed 's|^\./||' | sort); do
        files=$((files + 1))
        # The exit code is the verdict, which is why lean-verdict has three of
        # them: parsing the prose back out would be a third answer to a question
        # that already has one.
        set +e
        ./lean-check "$workspace_subdir" "$source" > /dev/null 2>&1
        code=$?
        set -e
        case $code in
            0) outcome=verified;    verified=$((verified + 1)) ;;
            2) outcome=conditional; conditional=$((conditional + 1)) ;;
            *) outcome=failed;      failed=$((failed + 1)) ;;
        esac

        # What the attempt filed at the time, if anything. `verified` is the
        # field every existing verdict carries; `outcome` is the newer one, and
        # is preferred when present so a conditional file is not read as failed.
        filed_path=$workspace_path/code/out/lean/$(echo "$source" | tr '/' '_').json
        if [ -f "$filed_path" ]; then
            filed=$(jq -r '.outcome // (if .verified then "verified" else "failed" end)' \
                    "$filed_path" 2>/dev/null || echo "unreadable")
        else
            filed="—"
        fi

        if [ "$filed" = "—" ]; then
            agrees="n/a"
        elif [ "$filed" = "$outcome" ]; then
            agrees="yes"
        else
            agrees="**DISAGREEMENT**"
            disagree=$((disagree + 1))
        fi

        printf '| `%s` | %s | %s | %s |\n' "$source" "$outcome" "$filed" "$agrees" >> "$report"
    done

    printf '\n%s files: %s verified, %s conditional, %s failed, %s disagreements.\n' \
        "$files" "$verified" "$conditional" "$failed" "$disagree" >> "$report"

    printf '| `%s` | %s | %s | %s | %s | %s |\n' \
        "$workspace_subdir" "$files" "$verified" "$conditional" "$failed" "$disagree" \
        >> "$summary"

    total_files=$((total_files + files))
    total_verified=$((total_verified + verified))
    total_conditional=$((total_conditional + conditional))
    total_failed=$((total_failed + failed))
    total_disagree=$((total_disagree + disagree))

    echo "$workspace_subdir: $files files, $verified verified, $conditional conditional, $failed failed, $disagree disagreements"
done

printf '| **total** | **%s** | **%s** | **%s** | **%s** | **%s** |\n' \
    "$total_files" "$total_verified" "$total_conditional" "$total_failed" "$total_disagree" \
    >> "$summary"

if [ "$total_files" -gt 0 ]; then
    printf '\nVerified sorry-free: %s of %s files.\n' "$total_verified" "$total_files" >> "$summary"
fi

echo ""
echo "wrote $summary"
echo "total: $total_files files, $total_verified verified, $total_conditional conditional, $total_failed failed, $total_disagree disagreements"
