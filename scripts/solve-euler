#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: ./euler [--no-research] [--schools a,b] <positive-problem-number> [extra instructions...]" >&2
    echo "       --no-research  withhold web search, so the run is a test of reasoning" >&2
    echo "       --schools a,b  run these schools concurrently (chisel, rising-sea," >&2
    echo "                      adversarial); default is chisel alone" >&2
}

research=on
schools=${MATH_AGENT_SCHOOLS:-}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-research)
            research=off
            shift
            ;;
        --research)
            research=on
            shift
            ;;
        --schools)
            if [ "$#" -lt 2 ]; then
                usage
                exit 2
            fi
            schools=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -lt 1 ]; then
    usage
    exit 2
fi

problem_number=$1
shift
case "$problem_number" in
    ""|0|*[!0-9]*)
        echo "problem number must be a positive integer" >&2
        exit 2
        ;;
esac

# A second pass, because everything after the number is free-text instructions
# and a flag written there would otherwise be swallowed into them silently. That
# is not hypothetical: `./euler 1006 --schools chisel,rising-sea` reads as the
# documented order to anyone who has typed `git log -n 5`, and it started a
# single-school run with "--schools chisel,rising-sea" appended to the task —
# a run that looks entirely normal and is not the one that was asked for. The
# flags are recognised in either position and stripped from the instructions.
remaining=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-research)
            research=off
            shift
            ;;
        --research)
            research=on
            shift
            ;;
        --schools)
            if [ "$#" -lt 2 ]; then
                usage
                exit 2
            fi
            schools=$2
            shift 2
            ;;
        *)
            remaining="$remaining${remaining:+ }$1"
            shift
            ;;
    esac
done

workspace_subdir=project-euler/$problem_number
workspace_path=$repository_root/workspace/$workspace_subdir
mkdir -p "$workspace_path"
workspace_path=$(CDPATH= cd -- "$workspace_path" && pwd -P)

export MATH_AGENT_WORKSPACE_PATH=$workspace_path
export MATH_AGENT_LOCAL_UID=$(id -u)
export MATH_AGENT_LOCAL_GID=$(id -g)

./agent --workspace "$workspace_subdir" build >/dev/null
docker compose run --rm --no-deps --entrypoint /bin/sh agent -c '
    set -eu
    mkdir -p /workspace/raw
    url="https://projecteuler.net/minimal=$1"
    curl --fail --silent --show-error --location \
        --retry 3 --retry-delay 1 --max-time 30 \
        --user-agent "math-agent-project-euler-wrapper/1.0" \
        "$url" > /workspace/raw/problem.html.tmp
    test -s /workspace/raw/problem.html.tmp
    mv /workspace/raw/problem.html.tmp /workspace/raw/problem.html
    mkdir -p /workspace/config
    printf "%s\n" "$url" > /workspace/config/problem.url
' sh "$problem_number"

if [ "$research" = off ]; then
    research_clause="Web search is disabled for this run, so solve the problem from the statement and your own mathematical reasoning. Do not ask research to search the web; it can only recall and record workspace notes."
else
    research_clause="Use research for mathematical definitions, named theorems, and standard algorithms, and cite the returned URLs. Never search for a published Project Euler answer, solution, or forum thread; searching for the answer invalidates the run."
fi

extra_instructions=$*
task="Solve Project Euler problem $problem_number. The official problem statement was downloaded from https://projecteuler.net/minimal=$problem_number and is saved at /workspace/problem.md.

Work in this order. Steps 1 and 2 together should take a small part of the run; most of it belongs in 3 and 4.

1. Understand by executing. Read the statement, restate it precisely in /workspace/GOAL.md with every symbol defined, and record the worked examples it gives — those are your test oracle. Then immediately have tool_builder write /workspace/code/brute.py, a naive but obviously-correct program, and run it to reproduce every one of those examples. If it cannot reproduce them, your reading of the definition is wrong and nothing else matters until it is fixed.

2. Identify the governing theory: the mathematical objects involved and the named theorem, algorithm, or identity that controls them. Record it under Established in /workspace/CONTEXT.md with the precise statement and hypotheses, and as a claim block in the note if it came from a source, so it reaches research/CLAIMS.md. $research_clause

3. Derive the efficient method and write the derivation to /workspace/solution.md: the result it rests on, why it applies, and what it reduces the work to. A method whose cost grows with the bound in the statement is the wrong method.

4. Implement it as /workspace/code/solution.py with exact integer or rational arithmetic. It must agree with code/brute.py on every case it can reach, and reproduce every example from the statement, before you run it at full size.

5. Verify the final answer by a second independent route — a different derivation, an independent program, or brute-force agreement at the largest size it can manage — and report which.

Delegate execution to tool_builder; it is the only agent that can run code. Spawn subagents asynchronously, keep every run ID, and await each response you rely on. Never search for a published answer.

In the final response, state the answer, explain the method and the result it rests on, report the verification command and what it confirmed, and list the saved files."

if [ -n "$extra_instructions" ]; then
    task="$task

Additional instructions: $extra_instructions"
fi

exec env MATH_AGENT_RESEARCH="$research" MATH_AGENT_SCHOOLS="$schools" \
    ./agent --workspace "$workspace_subdir" "$task"
