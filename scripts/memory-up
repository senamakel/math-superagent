#!/bin/sh
# Brings up the shared memory server and prints what a run needs to reach it.
#
# There is one server for the whole box (`compose.shared.yaml`), and which one
# is `MATH_AGENT_MEMORY`. What this script has to do differs between the two,
# and the difference is the whole of the security note in
# `src/orchestrator/cortex.rs`:
#
# - **cortex** (the default) has nothing per-problem to provision. The
#   self-hosted image cannot mint scoped tokens, so there is one operator
#   credential for the deployment and each problem is separated by the *scope*
#   its requests are built with, inside the runtime. This prints that one key.
# - **cognee** makes each problem a *tenant*: a Cognee user holding its own
#   datasets, reached with an `X-Api-Key` header, and the server refuses one
#   tenant's request for another's dataset — probed live, `404
#   DatasetNotFoundError`. That boundary is the server's rather than this
#   script's, and provisioning the tenant is what this script exists for.
#
# Either way it checks that the address actually answers *the selected
# engine's* readiness endpoint before printing it. That check is not
# ceremonial: `MATH_AGENT_MEMORY_URL` is one variable naming two servers that
# listen on different ports, so an address left pinned to the engine that is no
# longer selected is the easy mistake, and it would otherwise surface a run
# later as a memory that simply never answers.
#
# Usage: scripts/memory-up <workspace-label>        e.g. project-euler/620
#        scripts/memory-up --key <workspace-label>  print its API key
#        scripts/memory-up --down <workspace-label> forget the tenant's key
#        scripts/memory-up --list
#
# Prints the memory server's URL on stdout and nothing else, so a caller can
# read it directly, and the key under `--key` for the same reason:
#
#     MATH_AGENT_MEMORY_URL=$(scripts/memory-up project-euler/620)
#     MATH_AGENT_MEMORY_KEY=$(scripts/memory-up --key project-euler/620)
#
# Progress goes to stderr for exactly that reason. Both forms provision, so
# either order works and a second call costs one HTTP round trip.
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repository_root"

shared_project=${SHARED_PROJECT:-math-agent-shared}
shared_host=${MATH_AGENT_SHARED_HOST:-}
shared_path=${MATH_AGENT_SHARED_PATH:-math-agent-shared}


# A tenant's login, derived from the workspace label alone so that continuing a
# problem finds the tenant it left rather than making another. The password is
# a fixed local one, like `NEO4J_AUTH` in `compose.shared.yaml`: this server
# publishes no host port, and anything that can reach it is already inside the
# box's docker networks. `.local` and the other reserved suffixes are rejected
# by the server's own email validation, hence a real one nothing sends mail to.
tenant_domain=tenant.math-agent.dev
tenant_password=${COGNEE_TENANT_PASSWORD:-cognee-local-tenant}

usage() {
    echo "usage: scripts/memory-up [--key|--down] <workspace-label>" >&2
    echo "       scripts/memory-up --list" >&2
}

# Compose project names accepted lowercase letters, digits, dashes and
# underscores only, and the same folding is kept here so that a workspace keeps
# the tenant it had before this became a tenant. Every other character folds to
# a dash rather than being dropped: dropping would let `a/b` and `ab` name the
# same tenant, which is the one mistake this script must not make.
slug_of() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/^-*//; s/-*$//'
}

ensure_shared() {
    "$repository_root/scripts/shared-up" >&2
}

# Runs a command inside one of the shared stack's containers, wherever the
# stack is. Only `--list` needs this: it reads the server's own user table,
# which is an admin question the API answers for the caller's account alone and
# has to work before any tenant exists.
remote_exec() {
    if [ -n "$shared_host" ]; then
        # shellcheck disable=SC2029
        ssh "$shared_host" "cd '$shared_path' && docker compose -p '$shared_project' \
            -f compose.shared.yaml exec -T $*"
    else
        docker compose -p "$shared_project" -f compose.shared.yaml exec -T "$@"
    fi
}

# One request cycle against the server, over its published API.
#
# This used to run inside the container, because nothing was published to the
# host. The server can be on another machine now, so the transport is the same
# HTTP the runtime itself speaks — which also means provisioning needs no
# Docker access at all, only a reachable address.
tenant_api_key() {
    TENANT_EMAIL="$1@$tenant_domain" TENANT_PASSWORD="$tenant_password" \
        MEMORY_URL="$memory_url" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.parse, urllib.request

BASE = os.environ["MEMORY_URL"].rstrip("/")
email = os.environ["TENANT_EMAIL"]
password = os.environ["TENANT_PASSWORD"]


def call(path, data=None, form=False, token=None):
    headers = {"Accept": "application/json"}
    body = None
    if data is not None:
        if form:
            body = urllib.parse.urlencode(data).encode()
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        else:
            body = json.dumps(data).encode()
            headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(BASE + path, data=body, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            return response.status, response.read().decode()
    except urllib.error.HTTPError as error:
        return error.code, error.read().decode()


def login():
    return call("/api/v1/auth/login", {"username": email, "password": password}, form=True)


# Register first only when the tenant is new: registering an existing one is a
# 400 that says so, and reading that as failure would break every continuation.
status, body = login()
if status != 200:
    status, body = call("/api/v1/auth/register", {"email": email, "password": password})
    if status not in (200, 201):
        sys.exit(f"could not create the tenant {email}: {status} {body}")
    status, body = login()
    if status != 200:
        sys.exit(f"could not log the tenant {email} in: {status} {body}")

token = json.loads(body)["access_token"]

# Reuse the key this tenant already has. Minting one per call would leave a
# workspace continued ten times owning ten keys, all of them valid.
status, body = call("/api/v1/auth/api-keys", token=token)
if status != 200:
    sys.exit(f"could not list the tenant's keys: {status} {body}")
keys = [key["key"] for key in json.loads(body) if key.get("key", "").strip("*")]

if not keys:
    status, body = call("/api/v1/auth/api-keys", {"name": email}, token=token)
    if status != 200:
        sys.exit(f"could not create a key for the tenant: {status} {body}")
    keys = [json.loads(body)["key"]]

print(keys[0])
PY
}

action=up
case "${1:-}" in
    --list)
        if [ "${MATH_AGENT_MEMORY:-cortex}" != cognee ]; then
            # CortexDB has no tenant table to read; what it has is the scope
            # tree every write created, which is the same question asked of the
            # structure that actually separates the problems.
            . "$repository_root/scripts/dotenv"
            list_url=${MATH_AGENT_MEMORY_HOST_URL:-${MATH_AGENT_MEMORY_URL:-http://127.0.0.1:3141}}
            list_url=$(printf '%s' "$list_url" | sed 's|host\.docker\.internal|127.0.0.1|')
            curl -sf --max-time 30 "${list_url%/}/v1/scopes/list" \
                -H "Authorization: Bearer ${CORTEX_API_KEY:-cortex-local-shared}" \
                -H "X-Cortex-Actor: agent:memory-up" \
                | tr ',' '\n' | sed -n 's|.*\("'"${CORTEX_SCOPE_ROOT:-ws:math-agent}"'/[^"]*\)".*|\1|p' \
                | sort -u
            exit 0
        fi
        # Every workspace that has ever had a memory here, which is not every
        # problem currently running. Filtered to this runtime's tenant domain:
        # the server also carries Cognee's own built-in default user, which is
        # no workspace's and would read as one.
        remote_exec cognee python -c "
import sqlite3
# The server's own relational store. Read directly rather than over HTTP
# because listing users is an admin question and the API answers it only for
# the caller's own account — and this has to work before any tenant exists.
rows = sqlite3.connect('/app/cognee/.cognee_system/databases/cognee_db').execute(
    'select email from users order by email'
)
for (email,) in rows:
    print(email)
" 2>/dev/null | grep "@$tenant_domain\$" | sed "s/@$tenant_domain\$//" | sort -u
        exit 0
        ;;
    --key)
        action=key
        shift
        ;;
    --down)
        action=down
        shift
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
esac

label=${1:-}
if [ -z "$label" ]; then
    usage
    exit 2
fi

slug=$(slug_of "$label")
if [ -z "$slug" ]; then
    echo "workspace label '$label' has no usable characters" >&2
    exit 2
fi

if [ "$action" = down ]; then
    # Deliberately not a delete, on either engine. A tenant's datasets are its memory of the
    # problem, its graph databases are named after them, and a workspace is
    # continued far more often than it is abandoned — so the destructive
    # reading of "down" is the wrong default for a server that now holds every
    # problem's memory rather than one. `docs/memory.md` has the deletion path.
    echo "memory: tenants are not torn down; $slug keeps its datasets" >&2
    echo "memory: see docs/memory.md to delete one deliberately" >&2
    exit 0
fi

if [ ! -f .env ]; then
    echo "missing .env; copy .env.example and provide credentials" >&2
    exit 1
fi

# The checkout's credentials, over anything the calling shell exported. A memory
# server started with a key that is not this checkout's indexes nothing and says
# nothing; see `scripts/dotenv`.
. "$repository_root/scripts/dotenv"

# Where the memory server answers, from *this* box, resolved only now: the
# address lives in `.env`, so reading it before `scripts/dotenv` has run would
# silently fall back to the single-box default and then fail to connect to a
# server that is on another machine.
#
# The runtime inside a container is told the same address through
# `MATH_AGENT_MEMORY_URL`. Its default names the host gateway, which resolves to
# nothing from the host itself, so that one spelling is rewritten here — which
# is what lets a single variable configure both sides of the common case.
memory_engine=${MATH_AGENT_MEMORY:-cortex}
case "$memory_engine" in
    cortex|cortexdb) memory_engine=cortex ; default_url=http://127.0.0.1:3141 ; ready_path=/v1/admin/ready ;;
    cognee)          default_url=http://127.0.0.1:8000 ; ready_path=/health ;;
    *)
        echo "MATH_AGENT_MEMORY='$memory_engine' names no memory engine; it is cortex or cognee" >&2
        exit 2
        ;;
esac

memory_url=${MATH_AGENT_MEMORY_HOST_URL:-${MATH_AGENT_MEMORY_URL:-$default_url}}
memory_url=$(printf '%s' "$memory_url" | sed 's|host\.docker\.internal|127.0.0.1|')

ensure_shared

# The address answers the engine that is selected, or this stops here. See the
# header: one variable names two servers on two ports, and a stale pin is
# otherwise a run with a memory that never answers and never says why.
if ! curl -sf -o /dev/null --max-time 30 "${memory_url%/}$ready_path"; then
    echo "memory: $memory_url does not answer $memory_engine's $ready_path" >&2
    echo "memory: unset MATH_AGENT_MEMORY_URL to use $default_url, or point it at this engine" >&2
    exit 1
fi

if [ "$memory_engine" = cortex ]; then
    # One operator credential for the deployment, defaulted to the same literal
    # `compose.shared.yaml` hands the server, so the two sides cannot disagree
    # about what the key is. There is no per-problem provisioning to do: what
    # separates one problem's memory from another's is the scope the runtime
    # builds, and no tool argument reaches a scope.
    if [ "$action" = key ]; then
        printf '%s\n' "${CORTEX_API_KEY:-cortex-local-shared}"
    else
        printf '%s\n' "$memory_url"
    fi
    exit 0
fi

echo "memory: provisioning tenant $slug on the shared server" >&2
key=$(tenant_api_key "$slug" | tr -d '\r' | tail -1)
if [ -z "$key" ]; then
    echo "memory: could not provision a tenant for $slug" >&2
    exit 1
fi

if [ "$action" = key ]; then
    printf '%s\n' "$key"
else
    printf '%s\n' "$memory_url"
fi
