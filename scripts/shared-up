#!/bin/sh
# Brings up the shared backbone for every problem on the box: one memory server
# and one LLM router.
#
# Which memory server is `MATH_AGENT_MEMORY`. Unset it is `cortex` — one
# CortexDB, which carries its own graph and its own vector index. `cognee`
# starts the alternative instead, which is a Cognee *and* the Neo4j Enterprise
# instance it stores its graph in; both carry a Compose profile so neither runs
# when it is not the selected engine.
#
# Usage: scripts/shared-up            start or reconcile, waiting for health
#        scripts/shared-up --down     stop it; the volumes survive
#        scripts/shared-up --cypher <statement>   one statement, as admin
#        scripts/shared-up --cypher-in <db> <statement>   ... in one database
#
# Idempotent: `up -d --wait` against a stack that is already healthy returns
# immediately and starts nothing twice, which is why `scripts/memory-up` can
# call this on every problem it brings up rather than asking a human to
# remember the ordering.
#
# Nothing here is per-problem. `compose.shared.yaml` has the argument for what
# is shared and what deliberately is not.
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repository_root"

project=${SHARED_PROJECT:-math-agent-shared}
compose_file=compose.shared.yaml

# Which Compose profiles `compose()` runs with. Empty is the CortexDB half,
# which carries no profile; the Cognee half and its Neo4j both do. Every verb
# below sets this for itself, and the `up` path resolves it from
# `MATH_AGENT_MEMORY` *after* `scripts/dotenv` has run — reading it here would
# ignore an engine named in `.env`, which is the same ordering bug
# `scripts/memory-up` records against the memory address.
engine_profiles=""

# Where the shared stack runs. Empty means this box, which is the single-machine
# deployment and the default. Set `MATH_AGENT_SHARED_HOST` to an ssh host to put
# Neo4j, Cognee and the ladder on a machine of their own — they are the memory
# of every problem and none of the compute, so a box that only holds them frees
# the run box for runs.
#
# Run over ssh rather than through `DOCKER_HOST=ssh://…`, and the difference is
# not stylistic: with a remote `DOCKER_HOST`, Compose resolves this file's bind
# mounts against the *client's* filesystem and sends paths that mean nothing on
# the daemon's. The stack's own files therefore live beside it, in
# `MATH_AGENT_SHARED_PATH`, and compose runs there.
shared_host=${MATH_AGENT_SHARED_HOST:-}
shared_path=${MATH_AGENT_SHARED_PATH:-math-agent-shared}

compose() {
    if [ -n "$shared_host" ]; then
        # `cd` on the far side, so the compose project and its relative binds
        # resolve against the stack's own directory.
        # shellcheck disable=SC2029
        ssh "$shared_host" "cd '$shared_path' && docker compose -p '$project' -f '$compose_file' $engine_profiles $*"
    else
        # shellcheck disable=SC2086
        docker compose -p "$project" -f "$compose_file" $engine_profiles "$@"
    fi
}

# Runs against the `system` database, which is where `CREATE DATABASE` is the
# only valid place to send it. `exec` rather than a one-off `docker run` on the
# graph network: the container is already here, and naming it through compose
# means this keeps working if the network name ever moves.
admin_cypher() {
    if [ -n "$shared_host" ]; then
        # shellcheck disable=SC2029
        ssh "$shared_host" "cd '$shared_path' && docker compose -p '$project' \
            -f '$compose_file' exec -T neo4j cypher-shell -u neo4j -p cognee-local $(
                for argument in "$@"; do printf "'%s' " "$argument"; done
            )"
    else
        docker compose -p "$project" -f "$compose_file" \
            exec -T neo4j cypher-shell -u neo4j -p cognee-local "$@"
    fi
}

case "${1:-up}" in
    --down)
        # Every profile, not the selected one. A stack switched from Cognee to
        # CortexDB and then stopped would otherwise keep a Neo4j and a Cognee
        # running that nothing is pointed at, which is several gigabytes held
        # by a service no run can name.
        engine_profiles="--profile cognee"
        compose down >&2
        exit 0
        ;;
    --cypher)
        # Cognee's graph store only; CortexDB holds its graph itself and speaks
        # no Bolt. Selecting the profile explicitly so the verb works without
        # `MATH_AGENT_MEMORY=cognee` having been exported first.
        engine_profiles="--profile cognee"
        if [ "$#" -lt 2 ]; then
            echo "usage: scripts/shared-up --cypher <statement>" >&2
            exit 2
        fi
        admin_cypher "$2"
        exit 0
        ;;
    --cypher-in)
        engine_profiles="--profile cognee"
        # The same, against one problem's database rather than `system`.
        # `-d` rather than a `:use` line, because cypher-shell only reads
        # client commands from a script and not from a statement argument.
        if [ "$#" -lt 3 ]; then
            echo "usage: scripts/shared-up --cypher-in <database> <statement>" >&2
            exit 2
        fi
        admin_cypher -d "$2" "$3"
        exit 0
        ;;
    -h|--help|help)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    up)
        ;;
    *)
        echo "unknown argument: $1" >&2
        exit 2
        ;;
esac

# A remote stack keeps its own `.env` beside it, so nothing here needs this
# checkout's credentials — and must not send them.
if [ -z "$shared_host" ] && [ ! -f .env ]; then
    echo "missing .env; copy .env.example and provide credentials" >&2
    exit 1
fi

# The checkout's credentials, over anything the calling shell exported. The
# ladder reads `.env` for the memory key and its own file for the provider
# ones; see `scripts/dotenv`.
if [ -f .env ]; then
    . "$repository_root/scripts/dotenv"
fi

# The ladder's configuration and credentials live beside the checkout, not in
# it, and `compose.shared.yaml` says so as a path relative to itself. That
# resolves correctly from the main checkout and nowhere else: from
# `worktrees/<slug>` the same `../llm-ladder-router` points at a sibling
# worktree that does not exist, and Compose then fails on a missing env file
# rather than on anything to do with the ladder. Falling back to the main
# checkout's sibling makes a worktree able to start the shared stack, which is
# the whole point of the stack being shared.
if [ -z "${LADDER_CONFIG_PATH:-}" ] || [ -z "${LADDER_ENV_FILE:-}" ]; then
    ladder_home=$repository_root/../llm-ladder-router
    if [ ! -f "$ladder_home/config.toml" ]; then
        main_checkout=$(git -C "$repository_root" worktree list 2>/dev/null | head -1 | awk '{print $1}')
        if [ -n "$main_checkout" ] && [ -f "$main_checkout/../llm-ladder-router/config.toml" ]; then
            ladder_home=$main_checkout/../llm-ladder-router
        fi
    fi
    LADDER_CONFIG_PATH=${LADDER_CONFIG_PATH:-$ladder_home/config.toml}
    LADDER_ENV_FILE=${LADDER_ENV_FILE:-$ladder_home/.env}
    export LADDER_CONFIG_PATH LADDER_ENV_FILE
fi

# The memory server is waited for along with the rest: it has a healthcheck,
# and a run that starts against a server still initialising spends its first
# minutes failing recall calls it will never retry. A cold volume is the slow
# case, so `--wait` here is doing real work rather than confirming the obvious.
#
# CortexDB's healthcheck is `/v1/admin/ready` rather than `/v1/admin/health`,
# which matters more than it looks: health answers 200 while the server is
# pinned to mock embeddings, so waiting on it would report a memory that stores
# nothing findable as ready.
case "${MATH_AGENT_MEMORY:-cortex}" in
    cortex|cortexdb) engine_profiles="" ; engine_services="cortexdb, ladder" ;;
    cognee)          engine_profiles="--profile cognee" ; engine_services="neo4j, cognee, ladder" ;;
    *)
        echo "MATH_AGENT_MEMORY='${MATH_AGENT_MEMORY:-}' names no memory engine; it is cortex or cognee" >&2
        exit 2
        ;;
esac

if [ -n "$shared_host" ]; then
    echo "shared: bringing up $project on $shared_host ($engine_services)" >&2
else
    echo "shared: bringing up $project ($engine_services)" >&2
fi
compose up -d --wait >&2
