#!/bin/sh
# Says what one problem's memory server actually holds.
#
# The failure this exists for is silent: `POST /api/v1/remember` answers
# `200 {"status":"running"}` before it has read anything, and when the ingest
# pipeline then refuses to run — a model endpoint that will not answer is the
# way it happens — the document is dropped and never appears. A run whose memory
# is empty reads exactly like a run whose memory is full, until a recall comes
# back `404 No data found in the system`. See `docs/memory.md`.
#
# Usage: scripts/memory-inventory <workspace-label>   e.g. conjectures/gilbreath
#
# Brings the shared stack up if it is not already (`scripts/memory-up` is a
# no-op on one that is) and provisions this problem's tenant, then prints the
# server's ingest health followed by every dataset the tenant holds and the
# documents in it. One server holds every problem now, so the datasets listed
# are this tenant's alone — that is the server's answer, not a filter applied
# here.
set -eu

# `MATH_AGENT_MEMORY=cognee` only. This reads Cognee's own API and storage, and
# has no CortexDB equivalent — the two answer "what does this problem's memory
# hold" through different endpoints entirely. `docs/memory.md` has the
# CortexDB path.
if [ "${MATH_AGENT_MEMORY:-cortex}" != cognee ]; then
    echo "$(basename "$0"): Cognee only; MATH_AGENT_MEMORY is ${MATH_AGENT_MEMORY:-cortex}" >&2
    exit 2
fi


repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repository_root"

label=${1:-}
if [ -z "$label" ]; then
    echo "usage: scripts/memory-inventory <workspace-label>" >&2
    exit 2
fi

memory_url=$(scripts/memory-up "$label")
api_key=$(scripts/memory-up --key "$label")

get() {
    curl -s --max-time 60 -H "X-Api-Key: $api_key" "$memory_url$1"
}

echo "== ingest health"
get /health/detailed | python3 -c '
import json, sys

try:
    report = json.load(sys.stdin)
except ValueError:
    print("   unreadable health report"); raise SystemExit(0)
print("  ", report.get("status", "unknown"))
for name, component in sorted(report.get("components", {}).items()):
    status = component.get("status", "unknown")
    if status == "healthy":
        continue
    # Only what is broken, and in the server’s own words: a healthy component
    # says nothing a reader has to skip past.
    print(f"   {name}: {status} — {component.get('"'"'details'"'"', '"'"''"'"')[:160]}")
'

datasets=$(get /api/v1/datasets)
printf '%s' "$datasets" | python3 -c '
import json, subprocess, sys

memory_url, api_key = sys.argv[1], sys.argv[2]
for dataset in json.load(sys.stdin):
    listing = subprocess.run(
        ["curl", "-s", "--max-time", "60", "-H", f"X-Api-Key: {api_key}",
         f"{memory_url}/api/v1/datasets/{dataset['"'"'id'"'"']}/data"],
        capture_output=True, text=True).stdout
    try:
        rows = json.loads(listing)
    except ValueError:
        print(f"\n== {dataset['"'"'name'"'"']}  (unreadable)"); continue
    print(f"\n== {dataset['"'"'name'"'"']}  ({len(rows)} documents)")
    for row in sorted(rows, key=lambda row: row.get("createdAt") or ""):
        print("   ", (row.get("createdAt") or "")[:19], (row.get("name") or "")[:72])
' "$memory_url" "$api_key"
