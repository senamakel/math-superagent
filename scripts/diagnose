#!/bin/sh
# Reports the KPIs that decide whether a run is working.
#
# Watching a run means asking the same dozen questions every few minutes, and
# asking them by hand invites the two mistakes this script exists to prevent.
# The first is measuring the wrong thing: counting a role's *log lines* rather
# than its model calls once read as an organizer consuming half a run, and
# counting background team *cycles* rather than the calls they spend once read
# as a runaway director when the cycles were free. The second is a silent
# miss: `docker logs` needs `2>&1` because the runtime writes to stderr, and a
# reader who forgets it sees an empty log and calls a working run dead.
#
# So every number here is defined once, in one place, and the definition is
# what the comment beside it says. Nothing is inferred and nothing is judged —
# a KPI that needs a verdict gets the evidence printed beside it instead.
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: ./diagnose [<problem>|--workspace relative/path|--all]" >&2
    echo "" >&2
    echo "Reports the KPIs for a run that is going: role spend, solution-loop" >&2
    echo "progress, library growth, failure signals, turn shape, and whether" >&2
    echo "any solver produced something checkable. Reads only; changes nothing." >&2
    echo "" >&2
    echo "  ./diagnose 761                          one Project Euler run" >&2
    echo "  ./diagnose --workspace conjectures/erdos-gyarfas" >&2
    echo "  ./diagnose --all                        every live run" >&2
}

# Resolves the container whose /workspace mount is this workspace.
#
# By mount rather than by name: the container name carries a compose slug
# nobody can predict, and mapping a name back to a workspace by hand is what
# produced a report of a cross-project memory leak that did not exist.
#
# Which is why there is no `--filter name=` here any more. There was one, on
# `riemann-agent-run`, and it quietly undid the rule the comment above states:
# Compose takes the project name from the *directory*, so the filter matched
# only a checkout literally called `riemann`. In a worktree — where the folder
# is the branch name — every container was filtered out before the mount was
# ever compared, and `./diagnose` reported "container not running" for a run
# that was visible in `docker ps` at that moment. A name filter is exactly the
# name-based resolution this function exists to avoid.
# Each mount on its own line, and every line tested. The format used to be
# `{{range .Mounts}}{{.Source}}{{end}}`, which concatenates the sources with no
# separator — fine while a run had exactly one mount, and wrong the moment a
# calibration run added a second (the compiled blocklist at
# `/etc/riemann/screen.json`). The workspace path was then no longer at the end
# of the string, the `*/name` glob stopped matching, and the run again read as
# "not running".
container_for() {
    for id in $(docker ps -q); do
        mounts=$(docker inspect "$id" --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' 2>/dev/null || true)
        for mount in $mounts; do
            case "$mount" in
                */"$1") echo "$id"; return 0 ;;
            esac
        done
    done
    return 1
}

# `grep -c` already prints 0 when nothing matches — it just exits 1 while
# doing it. An `|| echo 0` on top of that prints a second zero, and every
# counter in the first version of this script reported "0\n0".
count() { grep -c "$1" "$2" 2>/dev/null || true; }

report() {
    workspace_subdir=$1
    workspace=workspace/$workspace_subdir

    if [ ! -d "$workspace" ]; then
        echo "no workspace at $workspace" >&2
        return 1
    fi

    container=$(container_for "$workspace_subdir" || true)
    echo "=============================================================="
    echo "  $workspace_subdir"
    echo "=============================================================="

    if [ -z "$container" ]; then
        echo "  container    not running"
    else
        log=$(mktemp)
        # 2>&1 is load-bearing: the runtime's console is stderr, and a live
        # container had 643 lines there and none on stdout.
        docker logs "$container" >"$log" 2>&1

        elapsed=$(grep -oE '^\[[0-9:]+\]' "$log" | tail -1)
        image=$(docker inspect "$container" --format '{{.Image}}' | cut -c8-19)
        stats=$(docker stats --no-stream --format '{{.CPUPerc}} {{.MemUsage}}' "$container" 2>/dev/null || true)
        echo "  container    ${container} image ${image}"
        echo "  elapsed      ${elapsed:-?}   ${stats}"

        # --- Role spend -------------------------------------------------
        # Model calls, not log lines. A role that reads twenty files in one
        # turn writes twenty lines and spends one call, and the two numbers
        # answer different questions.
        total=$(grep -c 'model call #' "$log" || echo 0)
        echo ""
        echo "  ROLE SPEND   $total model calls"
        grep 'model call #' "$log" \
            | grep -oE '^\[[0-9:]+\] [a-z_]+' \
            | awk '{print $2}' \
            | sort | uniq -c | sort -rn \
            | awk -v t="$total" '{printf "    %-18s %4d  %5.1f%%\n", $2, $1, (t>0?100*$1/t:0)}'

        # --- Solution loop ----------------------------------------------
        # The loop has to reach a judge before a reflection, and a reflection
        # before the inventor. Reporting all of them together is what shows
        # a run that is busy but has not advanced past attempt 1.
        echo ""
        echo "  LOOP"
        # A *verdict* is the loop scoring a returned attempt, and it is the
        # number that says the loop turned over. Counting `judge` spawns
        # instead conflates it with the review team, which spawns the same role
        # every twenty minutes against work still in flight — so a run that has
        # judged nothing reads as one that has judged four times.
        printf "    attempts %s  verdicts %s  reflection %s  diversify %s  inventor %s\n" \
            "$(count 'solution loop: attempt' "$log")" \
            "$(count 'solution loop: judge scored' "$log")" \
            "$(count 'reflection/agent-run-[0-9]* spawned' "$log")" \
            "$(count 'diversify' "$log")" \
            "$(count 'inventor/agent-run-[0-9]* spawned' "$log")"
        printf "    review-team judge spawns %s\n" \
            "$(count 'judge/agent-run-[0-9]* spawned' "$log")"
        grep -E 'solution loop: (verdict|judge)' "$log" | tail -2 | sed 's/^/    /' || true

        # --- Research ---------------------------------------------------
        echo ""
        echo "  RESEARCH"
        printf "    exa_search %s  downloads %s  research-team-retired %s\n" \
            "$(grep exa_search "$log" | grep -c done || true)" \
            "$(grep download_document "$log" | grep -c done || true)" \
            "$(count 'team research.*stopped' "$log")"

        # --- Failure signals --------------------------------------------
        # Each of these is a documented stall shape. `model call failed`
        # carries the provider's own reason, which is the line that turns a
        # repeated RETRY from a mystery into a diagnosis.
        echo ""
        echo "  FAILURES"
        printf "    truncated %s  retry %s  run-failed %s  402 %s  403 %s  429 %s\n" \
            "$(count TRUNCATED "$log")" \
            "$(count 'model RETRY' "$log")" \
            "$(count 'run   FAILED' "$log")" \
            "$(count 'HTTP 402' "$log")" \
            "$(count 'HTTP 403' "$log")" \
            "$(count 'HTTP 429' "$log")"
        grep 'model call failed' "$log" | grep -oE '\(.*\)' | sort | uniq -c \
            | sed 's/^/    cause /' || true
        # An OOM kill writes nothing to the console — the kernel stops the
        # process — so a vanished container reads as a hung child unless this
        # is checked separately.
        oom=$(docker events --filter event=oom --since 2h --until 0s 2>/dev/null | grep -c "$container" || true)
        [ "${oom:-0}" -gt 0 ] && echo "    OOM KILLS $oom"

        # --- Turn shape -------------------------------------------------
        # `out=` is total generated tokens, most of which are the hidden
        # reasoning channel: 77.8% of 5.2M tokens on a measured run. A cap
        # set from the visible answer is therefore set several times too low.
        echo ""
        echo "  TURN SHAPE (out= tokens, total generation incl. reasoning)"
        grep -oE 'out=[0-9]+' "$log" | cut -d= -f2 | sort -n \
            | awk '{a[NR]=$1} END {if(NR)printf "    n=%d  p50=%d  p90=%d  max=%d\n", NR, a[int(NR*0.5)], a[int(NR*0.9)], a[NR]; else print "    no completed turns"}'

        # --- Solver reality ---------------------------------------------
        # The cron's bar: a solver that ran must show something checkable.
        # A spawn count alone is the thing this section exists not to report.
        echo ""
        echo "  SOLVERS"
        for role in sat_solver smt_solver theorem_prover symbolic_math lean_prover; do
            n=$(count "$role/agent-run-[0-9]* spawned" "$log")
            [ "${n:-0}" -gt 0 ] && printf "    %-16s %s spawn(s)\n" "$role" "$n"
        done
        printf "    non-answers reported: %s\n" \
            "$(grep -cE 'ResourceOut|GaveUp|SZS status Unknown' "$log" || true)"

        rm -f "$log"
    fi

    # --- Library on disk ------------------------------------------------
    # Read from the workspace rather than the log, because it survives a
    # restart and the log does not.
    echo ""
    echo "  LIBRARY"
    printf "    sources %s  summaries %s  claims %s  approaches %s\n" \
        "$(ls "$workspace/research/sources" 2>/dev/null | wc -l | tr -d ' ')" \
        "$(ls "$workspace/research/summaries" 2>/dev/null | wc -l | tr -d ' ')" \
        "$(grep -c '^| ' "$workspace/research/CLAIMS.md" 2>/dev/null || true)" \
        "$(ls "$workspace/research/approaches" 2>/dev/null | wc -l | tr -d ' ')"
    # The frontier snapshot is read live, so a read can land mid-write and the
    # JSON parse fails. Say so rather than printing nothing: a silently absent
    # line reads as "this run has no frontier", and a live Erdős–Gyárfás run
    # with a 136 KB frontier reported exactly that for one sweep.
    if [ -f "$workspace/config/.frontier.json" ]; then
        python3 - "$workspace/config/.frontier.json" <<'PY' || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except (ValueError, OSError) as error:
    print(f"    frontier unreadable this sweep ({type(error).__name__}); the run is rewriting it")
else:
    fetched = sum(1 for v in d.values() if v.get("path"))
    print(f"    frontier {len(d)} candidates, {fetched} fetched, {len(d)-fetched} unworked")
PY
    fi
    # A claim the run established and one a paper asserted are different
    # things, and collapsing them is how a library looks like progress.
    if [ -f "$workspace/research/CLAIMS.md" ]; then
        printf "    claim evidence:"
        # Every label `Status::label` can emit. `checked` and `catalogued` were
        # missing, so a run's own verified computations and its catalogue
        # lookups were both invisible here: PE620 checked that its oracle model
        # returned 0 against a stated 9, wrote the claim, and this line still
        # reported `asserted=5` and nothing else. A babysit counter that
        # disagrees with the ledger it summarises is worse than no counter.
        grep -oE '\| (asserted|proved|checked|heuristic|catalogued|verified|computed|refuted) \|' "$workspace/research/CLAIMS.md" 2>/dev/null \
            | tr -d '| ' | sort | uniq -c | awk '{printf " %s=%s", $2, $1}' || true
        echo ""
    fi

    # --- Executed output ------------------------------------------------
    echo ""
    echo "  ARTIFACTS"
    # Captured output is counted the way the runtime counts it for the judge:
    # every non-source, non-note file under `code/`, not `code/out/` alone. PE761
    # writes `code/<program>_OUTPUT.txt` beside each program and left one empty
    # `Untitled` in `code/out/`, so counting the tidy location alone reported a
    # run with six captured outputs as having produced nothing — and a babysit
    # counter that disagrees with the counter the judge is shown is worse than no
    # counter, because both are believed.
    printf "    code files %s  captured output %s\n" \
        "$(find "$workspace/code" -name '*.py' 2>/dev/null | wc -l | tr -d ' ')" \
        "$(find "$workspace/code" -maxdepth 3 -type f \
            -not -path '*__pycache__*' -not -name '.*' \
            -not -name '*.py' -not -name '*.sh' -not -name '*.md' \
            2>/dev/null | wc -l | tr -d ' ')"
    echo "    written in the last 10 minutes:"
    # The run's hidden derived state is rewritten on nearly every tool call, so
    # listing it says only that the run is alive — which the elapsed clock above
    # already says. Left in, `.frontier.json` and `config/start.log` took four of
    # the eight slots on every run in one sweep and pushed the actual writes off
    # the list.
    find "$workspace" -type f -mmin -10 \
        -not -path '*/.workspace-history/*' \
        -not -path '*/.python-packages/*' \
        -not -path '*__pycache__*' \
        -not -name 'trace.jsonl' \
        -not -name '.*.json' \
        -not -path '*/config/start.log' \
        -not -path '*/config/problem.url' \
        2>/dev/null | head -8 | sed 's|^|      |' || true
    echo ""
}

workspace_subdir=${MATH_AGENT_WORKSPACE:-}
case "${1-}" in
    -h|--help|help)
        usage
        exit 0
        ;;
    --all)
        found=0
        # No name filter, for the reason given above `container_for`: the
        # compose project name is the checkout's directory, so filtering on
        # `riemann-agent-run` hid every run in a worktree. The `*/workspace/*`
        # mount test below is what identifies a run, and it is sufficient.
        for id in $(docker ps -q); do
            mounts=$(docker inspect "$id" --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' 2>/dev/null || true)
            for mount in $mounts; do
                case "$mount" in
                    */workspace/*)
                        report "${mount##*/workspace/}"
                        found=1
                        ;;
                esac
            done
        done
        [ "$found" -eq 1 ] || echo "no runs are going" >&2
        exit 0
        ;;
    --workspace)
        [ "$#" -ge 2 ] || { usage; exit 2; }
        workspace_subdir=$2
        ;;
    '')
        [ -n "$workspace_subdir" ] || { usage; exit 2; }
        ;;
    *)
        case "$1" in
            ''|*[!0-9]*)
                echo "problem must be a positive integer, or use --workspace" >&2
                exit 2
                ;;
        esac
        workspace_subdir=project-euler/$1
        ;;
esac

report "$workspace_subdir"
