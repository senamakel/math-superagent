#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: ./agent [run] [task...]" >&2
    echo "       ./agent build" >&2
    echo "       ./agent shell" >&2
}

action=run
if [ "$#" -gt 0 ]; then
    case "$1" in
        run|build|shell)
            action=$1
            shift
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
    esac
fi

mkdir -p workspace
if [ "$action" = build ]; then
    exec docker build --tag riemann-agent:local .
fi

if [ ! -f .env ]; then
    echo "missing .env; copy .env.example and provide credentials" >&2
    exit 1
fi

# Docker's --env-file preserves surrounding quotes, while dotenv parsers strip
# them. Source this trusted local file and forward names without placing secret
# values in the docker command line.
set -a
. "$repository_root/.env"
set +a
: "${OPENROUTER_API_KEY:?OPENROUTER_API_KEY is required in .env}"
: "${EXA_API_KEY:?EXA_API_KEY is required in .env}"
: "${LANGFUSE_BASE_URL:?LANGFUSE_BASE_URL is required in .env}"
: "${LANGFUSE_PUBLIC_KEY:?LANGFUSE_PUBLIC_KEY is required in .env}"
: "${LANGFUSE_SECRET_KEY:?LANGFUSE_SECRET_KEY is required in .env}"

docker build --quiet --tag riemann-agent:local . >/dev/null

if [ "$action" = shell ]; then
    exec docker run --rm --interactive --tty \
        --entrypoint /bin/sh \
        --env OPENROUTER_API_KEY \
        --env OPENROUTER_MODEL \
        --env EXA_API_KEY \
        --env LANGFUSE_BASE_URL \
        --env LANGFUSE_PUBLIC_KEY \
        --env LANGFUSE_SECRET_KEY \
        --user "$(id -u):$(id -g)" \
        --cap-drop ALL \
        --security-opt no-new-privileges \
        --pids-limit 256 \
        --memory 2g \
        --mount "type=bind,src=$repository_root/workspace,dst=/workspace" \
        riemann-agent:local
fi

exec docker run --rm \
    --env OPENROUTER_API_KEY \
    --env OPENROUTER_MODEL \
    --env EXA_API_KEY \
    --env LANGFUSE_BASE_URL \
    --env LANGFUSE_PUBLIC_KEY \
    --env LANGFUSE_SECRET_KEY \
    --user "$(id -u):$(id -g)" \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 256 \
    --memory 2g \
    --mount "type=bind,src=$repository_root/workspace,dst=/workspace" \
    riemann-agent:local "$@"
