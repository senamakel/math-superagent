#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: ./agent [--workspace relative/path] [--no-research] [--no-rlm] [run] [task...]" >&2
    echo "       ./agent [--workspace relative/path] build" >&2
    echo "       ./agent [--workspace relative/path] prompts" >&2
    echo "       ./agent [--workspace relative/path] shell" >&2
    echo "" >&2
    echo "  --no-research  withhold web search from the research agent" >&2
    echo "  --no-rlm       withhold map_document, the chunked recursive read;" >&2
    echo "                 the outline, selected read and search stay" >&2
    echo "  --schools a,b  run these schools concurrently on one workspace" >&2
    echo "                 (chisel, rising-sea, adversarial; default chisel alone)" >&2
}

workspace_subdir=${MATH_AGENT_WORKSPACE:-default}
research=${MATH_AGENT_RESEARCH:-on}
rlm=${MATH_AGENT_RLM:-on}
schools=${MATH_AGENT_SCHOOLS:-}
while [ "$#" -gt 0 ]; do
    case "${1-}" in
        --workspace)
            if [ "$#" -lt 2 ]; then
                usage
                exit 2
            fi
            workspace_subdir=$2
            shift 2
            ;;
        --no-research)
            research=off
            shift
            ;;
        --research)
            research=on
            shift
            ;;
        --no-rlm)
            rlm=off
            shift
            ;;
        --rlm)
            rlm=on
            shift
            ;;
        --schools)
            if [ "$#" -lt 2 ]; then
                usage
                exit 2
            fi
            schools=$2
            shift 2
            ;;
        *)
            break
            ;;
    esac
done
export MATH_AGENT_RESEARCH=$research
export MATH_AGENT_RLM=$rlm
# Passed through rather than validated here. The runtime keeps the default when
# the value names nothing it knows, under the same rule every other override
# follows, and a second list of the valid slugs in shell is exactly the
# duplicate answer this repository keeps having to delete.
export MATH_AGENT_SCHOOLS=$schools

case "/$workspace_subdir/" in
    /*/../*|/*/./*|//*|/*\\*|/./)
        echo "workspace must be a relative subdirectory without traversal" >&2
        exit 2
        ;;
esac
case "$workspace_subdir" in
    template|template-*)
        echo "workspace/$workspace_subdir is reserved as a workspace seed" >&2
        exit 2
        ;;
esac

# Extra compose files, applied to every invocation below.
#
# `./calibrate` sets this to `compose.eval.yaml`, which takes the container's
# default route away and mounts the compiled blocklist. It is an environment
# variable rather than a flag because the caller that needs it is another
# script, and because an ordinary run must be able to ignore it entirely.
compose_extra=""
if [ -n "${MATH_AGENT_COMPOSE_EXTRA:-}" ]; then
    for extra in $MATH_AGENT_COMPOSE_EXTRA; do
        if [ ! -f "$repository_root/$extra" ]; then
            echo "no compose overlay at $extra" >&2
            exit 2
        fi
        compose_extra="$compose_extra -f $extra"
    done
fi

# Every compose invocation carries the same file list, or an overlay would
# apply to the build and not to the run that uses it.
#
# `compose_files` rather than a shell function, because the invocations that
# hand the terminal over use `exec`, and `exec` needs a program rather than a
# function. Unquoted on use, which is what splits it into arguments.
compose_files="-f compose.yaml$compose_extra"

action=run
if [ "$#" -gt 0 ]; then
    case "$1" in
        run|build|shell|prompts)
            action=$1
            shift
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
    esac
fi

workspace_root=$repository_root/workspace
workspace_path=$workspace_root
if [ "$workspace_subdir" != . ]; then
    workspace_path=$workspace_path/$workspace_subdir
fi
mkdir -p "$workspace_path"
workspace_root=$(CDPATH= cd -- "$workspace_root" && pwd -P)
workspace_path=$(CDPATH= cd -- "$workspace_path" && pwd -P)
case "$workspace_path" in
    "$workspace_root"|"$workspace_root"/*) ;;
    *)
        echo "workspace resolves outside $workspace_root" >&2
        exit 2
        ;;
esac

# Two seeds: a shared base, and an overlay for the kind of problem this is.
#
# The overlay exists because the two kinds want opposite things from `code/`. An
# open conjecture is graded on what it *established*, so the mathematics leads
# and a program is evidence for a statement. A Project Euler problem has one
# number, so the oracle leads and Lean supplies the identity that number rests
# on. One `code/AGENTS.md` cannot say both, and the one it used to say — "this
# is a Python package tree", with no mention of `code/lean/` anywhere — is
# measurable: across eighteen conjecture workspaces the ratio of Python to Lean
# was 21:1 by line count, and nine of them held no Lean at all. The task text in
# `solve-conjecture` had said "WRITE THE MATHEMATICS IN LEAN, FROM THE FIRST
# HOUR" that entire time. A prompt instruction is not a control; the folder's
# own working agreement is closer to one.
#
# The kind is passed by the launcher and inferred from the path otherwise, so a
# direct `./agent --workspace ...` still works and simply gets the base.
if [ -z "${MATH_AGENT_TEMPLATE:-}" ]; then
    case "$workspace_subdir" in
        conjectures/*) MATH_AGENT_TEMPLATE=conjecture ;;
        project-euler/*) MATH_AGENT_TEMPLATE=euler ;;
        *) MATH_AGENT_TEMPLATE= ;;
    esac
fi

# The working agreements are the runtime's, not the run's, so they are refreshed
# on every launch. Everything else is seeded once and never overwritten: a
# `GOAL.md` or an `INDEX.md` the run has filled in is its work, and copying over
# it would delete that. Without this list an existing workspace would keep the
# `code/AGENTS.md` it was seeded with forever, which is exactly the eighteen
# workspaces above.
seed_workspace() {
    seed_path=$1
    [ -d "$seed_path" ] || return 0
    cp -R --update=none "$seed_path/." "$workspace_path/"
    for owned in AGENTS.md code/AGENTS.md code/lean/AGENTS.md; do
        if [ -f "$seed_path/$owned" ]; then
            mkdir -p "$workspace_path/$(dirname "$owned")"
            cp "$seed_path/$owned" "$workspace_path/$owned"
        fi
    done
}

seed_workspace "$workspace_root/template"
if [ -n "$MATH_AGENT_TEMPLATE" ]; then
    seed_workspace "$workspace_root/template-$MATH_AGENT_TEMPLATE"
fi

export MATH_AGENT_WORKSPACE_PATH=$workspace_path
# The container always mounts the selected workspace at /workspace, so nothing
# inside it can tell one problem's run from another's. The label is the only
# identity a Langfuse trace can carry that survives into the container.
export MATH_AGENT_WORKSPACE_LABEL=$workspace_subdir
export MATH_AGENT_LOCAL_UID=$(id -u)
export MATH_AGENT_LOCAL_GID=$(id -g)

if [ "$action" = build ]; then
    # shellcheck disable=SC2086
    exec docker compose $compose_files build agent
fi

# Prompt inspection runs on the host. It reads workspace files and renders the
# same assembly the runtime performs, so it needs neither the container nor a
# provider key, and must not cost anything to look at.
if [ "$action" = prompts ]; then
    exec cargo run --quiet --example dump_prompts -- "$workspace_path"
fi

if [ ! -f .env ]; then
    echo "missing .env; copy .env.example and provide credentials" >&2
    exit 1
fi

# The checkout's credentials, over anything the calling shell exported: Compose
# prefers the environment to the file, so a stale key in a login shell would
# outrank this checkout's silently. See `scripts/dotenv`.
. "$repository_root/scripts/dotenv"

# This problem's own memory server, brought up before the agent and joined by
# name. `COGNEE_NETWORK` is what `compose.yaml` resolves its external `memory`
# network to, and the agent reaches the server as `cognee:8000` inside it, so
# pointing the variable at a per-problem stack is the whole of the change — the
# runtime is unaware there is more than one.
#
# A shared server was the earlier arrangement and its failure was availability,
# not privacy: four concurrent runs turned `recall_memory` into a ten-minute
# hang ending in `409 Conflict`, and a run cannot retry ten minutes it has
# already spent. Set `COGNEE_NETWORK` yourself to opt back into a shared stack.
if [ -z "${COGNEE_NETWORK:-}" ]; then
    COGNEE_NETWORK=$("$repository_root/scripts/memory-up" "$workspace_subdir")
    export COGNEE_NETWORK
fi

if [ "$action" = shell ]; then
    # shellcheck disable=SC2086
    exec docker compose $compose_files run --rm --entrypoint /bin/sh agent
fi

# shellcheck disable=SC2086
docker compose $compose_files build --quiet agent
# shellcheck disable=SC2086
exec docker compose $compose_files run --rm agent "$@"
