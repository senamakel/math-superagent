#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

usage() {
    echo "usage: ./agent [--workspace relative/path] [run] [task...]" >&2
    echo "       ./agent [--workspace relative/path] build" >&2
    echo "       ./agent [--workspace relative/path] shell" >&2
}

workspace_subdir=${RIEMANN_WORKSPACE:-.}
if [ "${1-}" = --workspace ]; then
    if [ "$#" -lt 2 ]; then
        usage
        exit 2
    fi
    workspace_subdir=$2
    shift 2
fi

case "/$workspace_subdir/" in
    /*/../*|/*/./*|//*|/*\\*|/./)
        echo "workspace must be a relative subdirectory without traversal" >&2
        exit 2
        ;;
esac

action=run
if [ "$#" -gt 0 ]; then
    case "$1" in
        run|build|shell)
            action=$1
            shift
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
    esac
fi

workspace_path=$repository_root/workspace
if [ "$workspace_subdir" != . ]; then
    workspace_path=$workspace_path/$workspace_subdir
fi
mkdir -p "$workspace_path"

export RIEMANN_WORKSPACE_PATH=$workspace_path
export RIEMANN_LOCAL_UID=$(id -u)
export RIEMANN_LOCAL_GID=$(id -g)

if [ "$action" = build ]; then
    exec docker compose build agent
fi

if [ ! -f .env ]; then
    echo "missing .env; copy .env.example and provide credentials" >&2
    exit 1
fi

if [ "$action" = shell ]; then
    exec docker compose run --rm --entrypoint /bin/sh agent
fi

docker compose build --quiet agent
exec docker compose run --rm agent "$@"
