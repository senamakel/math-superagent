LIB "normal.lib";
ring r=0,(x,y),dp;
proc CB(xx, k)
{
  poly p = 1;
  int i;
  for(i=0;i<k;i++){ p = p*(xx-i); }
  return(p/factorial(k));
}
int k1, k2;
// k2=3, k1 up to 24
k2=3;
for(k1=13; k1<=24; k1=k1+1)
{
  poly F = CB(x,k1) - CB(y,k2);
  ideal I = F;
  "k2=3 k1=", k1, ": ", genus(I);
}
// k2=4, k1 up to 24
k2=4;
for(k1=13; k1<=24; k1=k1+1)
{
  poly F = CB(x,k1) - CB(y,k2);
  ideal I = F;
  "k2=4 k1=", k1, ": ", genus(I);
}
// k2=5, k1 up to 24
k2=5;
for(k1=13; k1<=24; k1=k1+1)
{
  poly F = CB(x,k1) - CB(y,k2);
  ideal I = F;
  "k2=5 k1=", k1, ": ", genus(I);
}
